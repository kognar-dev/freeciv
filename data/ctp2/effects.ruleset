; Call to Power II city radius: the worked area grows with city size.
; CTP2 radius_sq 2 / 5 / 13 / 17 / 20 at 0 / 6 / 18 / 32 / 46 citizens,
; with sizes scaled to this ruleset's maximum city size of 32.
[effect_ctp2_city_radius_3]
type    = "City_Radius_Sq"
value   = 3
reqs    =
    { "type", "name", "range"
      "MinSize", "3", "City"
    }

