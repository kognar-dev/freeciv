; /* <-- avoid gettext warnings
;
; Multipliers (aka policies), there can be up to 50:
;
; name                    = translatable name as seen by user
; rule_name               = (optional) internal name for savegames, rulesets
;                           etc; if not present, "name" is used for this
;                           purpose too. Since the name used in savegames must
;                           not change, if you want to rename an item after a
;                           ruleset has been released, you should set
;                           "rule_name" to the original value of "name".
; default                 = default value (as presented in UI)
; start                   = minimum value (as presented in UI)
; stop                    = maximum value (as presented in UI)
; step                    = minimum increase/decrease (as presented in UI)
; offset                  = offset/factor control how UI values are turned
; factor                  = into effect values for use in effects.ruleset.
;                           effect_value = (ui_value + offset) * (factor/100)
;                           Optional; by default offset=0, factor=100, so
;                           that UI values are used as-is.
; minimum_turns           = how often multiplier can be changed, or: how long one is stuck
;                           with the given value after changing to it
; reqs                    = requirements for adjusting this policy (see README.effects)
; helptext                = optional help text string; should escape all raw
;                           newlines so that xgettext parsing works
;
; */ <-- avoid gettext warnings

; Call to Power II style domestic policies (Empire Manager).
; In CTP2 these are global sliders that trade happiness for output.
; Each slider step moves the base number of content citizens per city
; (City_Unhappy_Size) by one; a negative balance creates angry citizens.

[multiplier_rations]
name      = _("Rations")
start     = -2
stop      = 2
step      = 1
default   = 0
; /* xgettext:no-c-format */
helptext  = _("\
How much food each citizen receives. Every step above normal makes \
one more citizen content in each city, but cities lose 10% of their \
food. Every step below normal leaves 10% more food for growth, but \
costs one content citizen per city.\
")

[multiplier_workday]
name      = _("Workday")
start     = -2
stop      = 2
step      = 1
default   = 0
; /* xgettext:no-c-format */
helptext  = _("\
How long your citizens work. Every step above normal increases \
shield production by 10%, but costs one content citizen per city. \
Every step below normal reduces shield production by 10% and makes \
one more citizen content in each city.\
")

[multiplier_wages]
name      = _("Wages")
start     = -2
stop      = 2
step      = 1
default   = 0
; /* xgettext:no-c-format */
helptext  = _("\
How much your workers are paid. Every step above normal makes one \
more citizen content in each city, but 10% of the cities' gold goes \
to wages. Every step below normal adds 10% gold, but costs one \
content citizen per city.\
")

[multiplier_demobilization]
name      = _("Demobilization")
start     = 0
stop      = 2
step      = 1
default   = 0
minimum_turns = 5
; /* xgettext:no-c-format */
helptext  = _("\
Military readiness: 0 is At War, 1 is On Alert, 2 is At Peace. \
Every step of demobilization lets each city support one more unit \
without shield upkeep, but your units attack and defend 25% worse. \
After changing this setting you must keep it for 5 turns.\
")

[multiplier_public_works]
name      = _("Public Works Tax")
start     = 0
stop      = 50
step      = 10
default   = 10
factor    = 10
; /* xgettext:no-c-format */
helptext  = _("\
Percentage of every city's shield production diverted to the \
national Public Works pool (infrapoints). Public Works are spent \
to place tile improvements such as roads, irrigation and mines \
directly on tiles inside your borders, without Workers. Larger \
cities contribute more points.\
")
