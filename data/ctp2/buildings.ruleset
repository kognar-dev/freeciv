[building_space_structural]
name		= _("Space Structural")
genus		= "Special"
reqs	=
    { "type", "name", "range"
      "Tech", "Space Flight", "Player"
      "Building", "Factory", "City"
      "Building", "Academy", "City"
      "Building", "University", "City"
      "Building", "Computer Center", "City"
    }
